  "practicalNotes": [
    {
      "id": "note:place:Q3130:expansion01-history",
      "destinationId": "place:Q3130",
      "kind": "other",
      "text": {
        "en": "The harbour is Gadigal Country, with a history far older than the colonial buildings of The Rocks. Tubowgule, now Bennelong Point, was a gathering place before the Opera House; read that history alongside the familiar skyline."
      },
      "reviewStatus": "reviewed",
      "reviewedAt": "2026-10-26T15:24:23.533Z",
