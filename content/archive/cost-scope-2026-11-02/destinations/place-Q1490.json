  "practicalNotes": [
    {
      "id": "note:place:Q1490:expansion01-history",
      "destinationId": "place:Q1490",
      "kind": "other",
      "text": {
        "en": "Sensoji anchors Asakusa’s temple streets. Across the city, Meiji Jingu honours Emperor Meiji and Empress Shōken in a planted forest, giving a short stay two very different views of Tokyo’s history."
      },
      "reviewStatus": "reviewed",
      "reviewedAt": "2026-10-23T22:18:25.499Z",
