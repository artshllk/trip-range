    },
    {
      "id": "note:place:Q1490:batch2-visitor-alternatives",
      "destinationId": "place:Q1490",
      "kind": "booking",
      "text": {
        "en": "Visit Meiji Jingu during its published opening period; the shrine closes towards sunset. If Skytree deck entry is unavailable, keep the Asakusa outing and consider Sumida River Walk if it is open. The park, shrine and observation decks have separate visitor arrangements."
      },
