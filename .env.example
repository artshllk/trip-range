# Server-only credentials; optional locally, required for public V1 as noted.
# Never prefix with NEXT_PUBLIC.
# Required for public flight discovery: recent/cached fares, not live inventory.
TRAVELPAYOUTS_API_TOKEN=
# Required for public affiliate handoff; project must be connected to Aviasales.
TRAVELPAYOUTS_PROJECT_ID=
TRAVELPAYOUTS_MARKER=
# Wikimedia Commons is keyless and is the primary external image provider.
# Optional Pexels fallback after Commons; attributed, unverified location.
PEXELS_API_KEY=

# Server-controlled AI opt-in: absent/false is OFF; set true to enable.
GOEKSPLO_AI_ENABLED=
# Optional server-only AI. Defaults to gpt-6-luna when OPENAI_MODEL is blank.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required in deployed production and previews with provider credentials.
# Missing/invalid config or a Redis outage falls back to per-instance memory
# counts with the same limits (server only); /api/ready reports it.
# Keys are automatically scoped goeksplo:v2:<environment>:limit:<operation>.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Per-client limiter on /plan and /api/* (docs/abuse-controls.md, Option B).
# Uses the database above under its own key prefix. Off without a secret; it
# always fails open (allows requests) when unset, invalid or unreachable.
# At least 32 characters, e.g. `openssl rand -base64 48`.
CLIENT_LIMIT_SECRET=
# Server-only verbosity: debug, info (default), warn, error, off.
GOEKSPLO_LOG_LEVEL=
