      "destinationId": "place:Q612",
      "kind": "other",
      "text": {
        "en": "Al Fahidi preserves traditional wind-tower architecture and streets from the city’s trading past. Al Shindagha’s museum adds context to life around the creek, while Downtown shows a very different stage of the city’s development."
      },
      "reviewStatus": "reviewed",
