    {
      "id": "note:place:Q1861:expansion01-cost-limits",
      "destinationId": "place:Q1861",
      "kind": "booking",
      "text": {
        "en": "Temple tickets, river crossings, airport travel, meals and rooms need individual checks. This guide gives no reviewed food allowance and does not assume a meal or transfer is included in a ticket."
      },
      "reviewStatus": "reviewed",
      "reviewedAt": "2026-10-23T22:18:27.150Z",
