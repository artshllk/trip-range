      "id": "note:place:Q1861:expansion01-history",
      "destinationId": "place:Q1861",
      "kind": "other",
      "text": {
        "en": "The Grand Palace and Wat Phra Kaew form the royal and religious core of Rattanakosin. Wat Pho sits nearby, while Wat Arun stands across the Chao Phraya: the river is part of the city’s geography, not just a view."
      },
      "reviewStatus": "reviewed",
      "reviewedAt": "2026-10-23T22:18:27.150Z",
