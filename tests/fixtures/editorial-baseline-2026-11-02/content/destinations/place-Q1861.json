    {
      "id": "note:place:Q1861:batch2-visitor-alternatives",
      "destinationId": "place:Q1861",
      "kind": "booking",
      "text": {
        "en": "Check the official palace calendar as well as the dress code. The Grand Palace and Wat Phra Kaew may have different restrictions. If your planned visit is unavailable, consider Wat Pho or Wat Arun after checking its own entry arrangements; neither is an included substitute for a palace ticket."
      },
