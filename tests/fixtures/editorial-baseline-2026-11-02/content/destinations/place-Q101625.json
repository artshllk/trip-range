      "destinationId": "place:Q101625",
      "kind": "other",
      "text": {
        "en": "A former royal capital, Marrakesh keeps much of its identity in its medina, the Koutoubia minaret and the Menara gardens. Jardin Majorelle adds a different, artist-created garden landscape beyond the old-city core."
      },
      "reviewStatus": "reviewed",
      "reviewedAt": "2026-10-23T22:18:27.971Z",
