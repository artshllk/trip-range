{
  "name": "goeksplo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node --conditions=react-server --test .test-build/tests/*.test.js scripts/check-travelpayouts.test.mjs scripts/check-history-secrets.test.mjs scripts/check-import-boundaries.test.mjs scripts/preview-destination-content.test.mjs scripts/content-manifests.test.mjs scripts/eurostat-snapshot.test.mjs scripts/check-next-advisories.test.mjs scripts/qstash-schedules.test.mjs",
    "check:travelpayouts": "tsc -p tsconfig.seo.json && node --conditions=react-server scripts/check-travelpayouts.mjs",
    "report:fare-ages": "node scripts/report-fare-ages.mjs",
    "check:affiliate": "tsc -p tsconfig.affiliate.json && node --conditions=react-server .diagnostic-build/scripts/check-affiliate.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"tests/**/*.ts\"",
    "verify:production": "tsc -p tsconfig.seo.json && node scripts/verify-production.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:seo": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/check-seo.js",
    "review:seo-indexing": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/review-seo-indexing.js",
    "check:markets": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/check-markets.js",
    "check:pricing": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/check-pricing.js",
    "research:markets": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/research-markets.js",
    "validate:seo-candidates": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/validate-seo-candidates.js",
    "check:cost-profiles": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/check-cost-profiles.js",
    "check:rate-limit": "tsc -p tsconfig.seo.json && node --conditions=react-server .seo-build/scripts/check-rate-limit.js",
    "check:history-secrets": "node scripts/check-history-secrets.mjs",
    "check:destination-media": "tsc -p tsconfig.media.json && node --conditions=react-server .media-build/scripts/check-destination-media.js",
    "discover:destination-media": "tsc -p tsconfig.media.json && node --conditions=react-server .media-build/scripts/discover-destination-media.js",
    "calibrate:destination-media": "tsc -p tsconfig.media.json && node --conditions=react-server .media-build/scripts/calibrate-destination-media.js",
    "check:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-destination-content.js",
    "research:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/research-destination-content.js",
    "review:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/review-destination-content.js",
    "pipeline:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/pipeline-destination-content.js",
    "preview:destination-content": "tsc -p tsconfig.content.json && node scripts/preview-destination-content.mjs",
    "generate:content-manifests": "node scripts/content-manifests.mjs --write",
    "check:content-manifests": "node scripts/content-manifests.mjs --check",
    "prebuild": "npm run check:content-manifests && npm run check:destination-reviews && npm run check:destination-media",
    "pretest": "npm run check:content-manifests",
    "check:destination-access": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-destination-access.js",
    "check:places": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-places.js",
    "coverage:destinations": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/coverage-destinations.js",
    "review:destinations": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/review-destinations.js",
    "set:destination-review": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/set-destination-review.js",
    "approve:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/approve-destination-content.js",
    "due:destination-content": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/due-destination-content.js",
    "check:destination-reviews": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-destination-reviews.js",
    "check:fx": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-fx.js",
    "check:expiry": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-expiry.js",
    "refresh:fx": "node scripts/refresh-fx.mjs",
    "check:sweep-yield": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-sweep-yield.js",
    "check:collector-health": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-collector-health.js",
    "check:warm-coverage": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-warm-coverage.js",
    "check:storage": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-storage.js",
    "warm:fares": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/fare-warm-run.js",
    "check:accommodation": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/check-accommodation.js",
    "holdout:room-panels": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/holdout-room-panels.js",
    "snapshot:eurostat": "node scripts/eurostat-snapshot.mjs",
    "review:destination-batch": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/review-destination-batch.js",
    "check:dependencies": "npm audit --audit-level=moderate && node scripts/check-next-advisories.mjs",
    "refresh:ine-rooms": "tsc -p tsconfig.content.json && node --conditions=react-server .content-build/scripts/refresh-ine-rooms.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "marked": "15.0.12",
    "prettier": "^3.8.1",
    "semver": "7.7.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
