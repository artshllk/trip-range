  "queryString": "SELECT\n  `id_struttura`,\n  `provincia`,\n  `nome_comune`,\n  `denominazione_struttura`,\n  `categoria`,\n  `classificazione`,\n  `indirizzo`,\n  `cap`,\n  `frazione`,\n  `localita`,\n  `cir`,\n  `email`,\n  `tel`,\n  `fax`,\n  `web`,\n  `camere`,\n  `suite`,\n  `letti`,\n  `bagni`,\n  `prima_colazione`,\n  `in_abitato`,\n  `sul_lago`,\n  `vicino_eliporto`,\n  `vicino_aereoporto`,\n  `zona_centrale`,\n  `vicino_imp_risalita`,\n  `zona_periferica`,\n  `zona_stazione_fs`,\n  `attrezzature`,\n  `attrezzature_carte`,\n  `attrezzature_lingue`,\n  `attrezzature_sport`,\n  `attrezzature_congressi`,\n  `geo_y`,\n  `geo_x`,\n  `locatio1`,\n  `:@computed_region_ttgh_9sm5`,\n  `:@computed_region_af5v_nc64`,\n  `:@computed_region_6hky_swhk`,\n  `:@computed_region_ypj4_hixw`,\n  `:@computed_region_5aqa_mzrh`\nWHERE\n  caseless_eq(`nome_comune`, \"MILANO\")\n  AND caseless_not_one_of(\n    `denominazione_struttura`,\n    \"Monnaflat - Beato Angelico 19;\"\n  )",
