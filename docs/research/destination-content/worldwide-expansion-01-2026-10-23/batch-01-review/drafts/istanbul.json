  "practicalNotes": [
    {
      "id": "note:istanbul:expansion01-history",
      "destinationId": "istanbul",
      "kind": "other",
      "text": {
        "en": "Hagia Sophia’s surviving structure dates from the Byzantine period; Topkapı later served as an Ottoman palace and administrative centre. Their different histories are visible within the same compact sightseeing area."
      },
      "reviewStatus": "draft",
      "reviewedAt": null,
