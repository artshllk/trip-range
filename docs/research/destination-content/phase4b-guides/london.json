      },
      "name": {
        "en": "Westminster Abbey"
      },
      "kind": "religious-site",
      "shortDescription": {
        "en": "A historic royal church near Parliament. Choose an interior visit for the architecture and memorials, or begin with the surrounding Westminster streets."
      },
      "bookingAdvice": {
        "en": "Book sightseeing through the Abbey and check its visitor calendar. Sundays are for worship, not sightseeing; choose the exterior walk or another day for the interior."
      }
    },
    {
      "id": "attraction:london:national-gallery",
