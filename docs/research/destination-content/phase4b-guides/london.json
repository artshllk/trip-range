      "name": {
        "en": "Tower of London"
      },
      "kind": "historic-site",
      "shortDescription": {
        "en": "A riverside fortress with royal and prison history and the Crown Jewels. This is the Tower of London, not the neighbouring Tower Bridge."
      },
      "bookingAdvice": {
        "en": "Check official tickets, closures and the visitor plan before committing the day."
      }
