      },
      "name": {
        "en": "National Gallery"
      },
      "kind": "museum",
      "shortDescription": {
        "en": "Paintings on Trafalgar Square make a focused art stop without planning a whole museum day. Choose a few rooms or works rather than the entire collection."
      },
      "bookingAdvice": {
        "en": "General collection admission is free; some exhibitions are paid. Check entry arrangements. Groups above seven need the gallery’s group booking process."
      }
    },
