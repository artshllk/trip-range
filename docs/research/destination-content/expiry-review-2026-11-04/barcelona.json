      "id": "note:city:BCN:expansion01-history",
      "destinationId": "city:BCN",
      "kind": "other",
      "text": {
        "en": "The Gothic Quarter follows the Roman and medieval core. The later Eixample grid gave the expanding city room for the modernista buildings that still shape its streets."
      },
      "reviewStatus": "draft",
