{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "outDir": ".test-build"
  },
  "include": [
    "src/domain/**/*.ts",
    "tests/**/*.ts",
    "src/components/travel/SearchEditor.tsx"
  ],
  "exclude": ["node_modules"]
}
